# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key — required for booking requests to be delivered.
# Get a free key at https://resend.com (Dashboard → API Keys).
RESEND_API_KEY=

# Where consultation requests are emailed. Defaults to booipractice@outlook.com.
BOOKING_TO_EMAIL=booipractice@outlook.com

# Verified Resend sender. For testing you may use onboarding@resend.dev.
# In production, verify booipractice.co.za in Resend and use e.g. bookings@booipractice.co.za.
BOOKING_FROM_EMAIL=onboarding@resend.dev
